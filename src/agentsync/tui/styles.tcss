/* AgentSync Modern Dark High-Contrast TCSS */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

#top-header {
    dock: top;
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 1;
    align: left middle;
}

#brand-title {
    color: #58a6ff;
    text-style: bold;
    padding: 0 2 0 0;
}

#status-badge {
    background: #1f6feb;
    color: #ffffff;
    padding: 0 1;
    margin: 0 1;
    text-style: bold;
}

#status-badge.warn {
    background: #9e6a03;
}

#status-badge.busy {
    background: #238636;
}

#env-badge {
    color: #8b949e;
    padding: 0 1;
}

.header-spacer {
    width: 1fr;
}

#btn-mode-toggle {
    min-width: 14;
    height: 1;
    margin: 0 1;
    border: none;
    background: #21262d;
    color: #79c0ff;
}

#btn-mode-toggle.auto-mode {
    background: #1f6feb;
    color: #ffffff;
}

.lang-btn {
    min-width: 5;
    height: 1;
    margin: 0 0 0 1;
    border: none;
    background: #21262d;
    color: #8b949e;
}

.lang-btn.active {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

#body-row {
    height: 1fr;
}

#nav-rail {
    width: 24;
    background: #12171f;
    border-right: solid #30363d;
    padding: 1 1;
}

.nav-btn {
    width: 100%;
    margin-bottom: 1;
    content-align: left middle;
    background: #161b22;
    color: #c9d1d9;
    border: none;
    height: 3;
}

.nav-btn:hover {
    background: #21262d;
}

.nav-btn.active {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

#main-switcher {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.pane-scroll {
    height: 1fr;
    width: 1fr;
}

.section-title {
    color: #58a6ff;
    text-style: bold;
    margin-bottom: 1;
}

.card {
    height: auto;
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

#detected-checklist, #undetected-list {
    height: auto;
}

.btn-row {
    height: auto;
    margin-bottom: 1;
}

.btn-row Button {
    margin-right: 1;
}

.app-check-row {
    height: auto;
    padding: 0 1;
    margin-bottom: 0;
}

#dash-summary {
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    color: #8b949e;
    margin-top: 1;
}

#progress-panel {
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

#op-status {
    color: #79c0ff;
    margin-bottom: 1;
}

DataTable {
    height: 14;
    background: #0d1117;
    border: solid #30363d;
    margin-bottom: 1;
}

RichLog {
    height: 8;
    background: #0d1117;
    border: solid #30363d;
    padding: 0 1;
}

#bottom-footer {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}

/* Modals & Wizard */

ConfirmModal, OnboardingModal {
    align: center middle;
    background: rgba(1, 4, 9, 0.78);
}

#modal-box, #wizard-box {
    width: 78;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: thick #58a6ff;
    padding: 1 2;
}

#wizard-step-label {
    color: #79c0ff;
    text-style: bold;
    margin-bottom: 1;
}

#wizard-body {
    height: auto;
    min-height: 8;
    max-height: 18;
    margin-bottom: 1;
}

#wizard-nav {
    height: auto;
    min-height: 3;
}
