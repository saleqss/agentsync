/* AgentSync v0.4.0 Responsive Dark High-Contrast TCSS (Zero Half-Block Borders) */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Eliminate Textual's tall/hkey half-block borders globally so legacy Windows conhost renders zero '?' glyphs */
Button {
    border: none;
    height: 1;
    min-width: 10;
    padding: 0 2;
    background: #21262d;
    color: #e6edf3;
    text-style: none;
}

Button:hover {
    background: #30363d;
    color: #ffffff;
}

Button:focus {
    background: #388bfd;
    color: #ffffff;
    text-style: bold reverse;
}

Button.-primary {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

Button.-primary:hover {
    background: #388bfd;
}

Button.-success {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

Button.-success:hover {
    background: #2ea043;
}

Button.-warning {
    background: #9e6a03;
    color: #ffffff;
    text-style: bold;
}

Button.-warning:hover {
    background: #bb8009;
}

Button.-error {
    background: #da3633;
    color: #ffffff;
    text-style: bold;
}

Button.-error:hover {
    background: #f85149;
}

Checkbox {
    border: none;
    background: transparent;
    padding: 0 1;
    height: auto;
    color: #8b949e;
}

Checkbox.-on {
    color: #e6edf3;
}

Checkbox > .toggle--button {
    background: #21262d;
    color: #6e7681;
    text-style: bold;
}

Checkbox.-on > .toggle--button {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

Checkbox:focus {
    background: #1f2937;
    color: #ffffff;
}

Switch {
    border: none;
    height: 1;
    background: #21262d;
}

Switch.-on {
    background: #238636;
}

Collapsible {
    border: solid #30363d;
    background: #161b22;
    padding: 0 1;
    margin-bottom: 1;
}

CollapsibleTitle {
    border: none;
    background: #161b22;
    color: #8b949e;
}

Input {
    border: solid #30363d;
    height: 3;
    background: #0d1117;
    color: #e6edf3;
}

Input:focus {
    border: solid #58a6ff;
}

Select > SelectCurrent {
    border: solid #30363d;
    background: #0d1117;
    color: #e6edf3;
}

/* Header */
#top-header {
    dock: top;
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 1;
    align: left middle;
}

#brand-title {
    color: #58a6ff;
    text-style: bold;
    padding: 0 1 0 0;
}

#status-badge {
    background: #1f6feb;
    color: #ffffff;
    padding: 0 1;
    margin: 0 1 0 0;
    text-style: bold;
}

#status-badge.warn {
    background: #9e6a03;
}

#status-badge.busy {
    background: #238636;
}

#btn-update-badge {
    display: none;
    background: #8957e5;
    color: #ffffff;
    min-width: 12;
    height: 1;
    padding: 0 1;
    margin: 0 1 0 0;
    text-style: bold;
}

#btn-update-badge.visible {
    display: block;
}

#env-badge {
    color: #8b949e;
    padding: 0 1;
}

.header-spacer {
    width: 1fr;
}

#btn-mode-toggle {
    min-width: 12;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #21262d;
    color: #79c0ff;
}

#btn-mode-toggle.auto-mode {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

.lang-btn {
    min-width: 4;
    height: 1;
    padding: 0 1;
    margin: 0 0 0 1;
    background: #21262d;
    color: #8b949e;
}

.lang-btn.active {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

/* Body Layout */
#body-row {
    height: 1fr;
}

#nav-rail {
    width: 22;
    background: #12171f;
    border-right: solid #30363d;
    padding: 1 1;
}

.nav-btn {
    width: 100%;
    margin-bottom: 1;
    content-align: left middle;
    background: #161b22;
    color: #c9d1d9;
    height: 1;
    padding: 0 1;
}

.nav-btn:hover {
    background: #21262d;
}

.nav-btn.active {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

#main-switcher {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.pane-scroll {
    height: 1fr;
    width: 1fr;
}

.section-title {
    color: #58a6ff;
    text-style: bold;
    margin-bottom: 1;
}

.card {
    height: auto;
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

#detected-checklist, #undetected-list {
    height: auto;
}

/* Responsive Wrapping Action & Option Grids (Zero Horizontal Overflow at 80x24!) */
.action-grid {
    layout: grid;
    grid-size: 4;
    grid-gutter: 1 1;
    height: auto;
    margin-bottom: 1;
}

.action-grid Button {
    width: 100%;
}

.action-grid-3 {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1 1;
    height: auto;
    margin-bottom: 1;
}

.action-grid-3 Button {
    width: 100%;
}

.opt-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 1;
    height: auto;
    margin-bottom: 1;
}

.opt-grid Input, .opt-grid Select, .opt-grid Checkbox {
    width: 100%;
}

.switch-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.switch-row Label {
    width: 1fr;
    padding: 0 1 0 0;
}

.btn-row {
    height: auto;
    margin-bottom: 1;
}

.btn-row Button {
    margin-right: 1;
}

.app-check-row {
    height: auto;
    width: 100%;
    padding: 0 1;
    margin-bottom: 0;
}

.muted-hint {
    color: #8b949e;
    margin-bottom: 1;
}

#dash-summary, #backups-summary {
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    color: #c9d1d9;
    margin-top: 1;
    margin-bottom: 1;
}

#progress-panel {
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

#op-status {
    color: #79c0ff;
    margin-bottom: 1;
}

DataTable {
    height: 12;
    background: #0d1117;
    border: solid #30363d;
    margin-bottom: 1;
}

RichLog {
    height: 8;
    background: #0d1117;
    border: solid #30363d;
    padding: 0 1;
}

#bottom-footer {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}

/* Breakpoints applied dynamically via on_resize */
Screen.compact #nav-rail {
    width: 9;
    padding: 1 0;
}

Screen.compact .nav-btn {
    content-align: center middle;
    padding: 0;
}

Screen.compact #main-switcher {
    padding: 0 1;
}

Screen.compact #env-badge {
    display: none;
}

Screen.compact .card {
    padding: 1 1;
}

Screen.compact .action-grid, Screen.compact .action-grid-3 {
    grid-size: 2;
}

Screen.compact .opt-grid {
    grid-size: 1;
}

Screen.compact DataTable {
    height: 8;
}

Screen.medium #nav-rail {
    width: 20;
}

Screen.medium .action-grid {
    grid-size: 3;
}

Screen.medium .opt-grid {
    grid-size: 2;
}

Screen.wide #nav-rail {
    width: 24;
}

Screen.wide .action-grid {
    grid-size: 4;
}

Screen.wide .opt-grid {
    grid-size: 2;
}

/* Legacy Windows conhost.exe pure-ASCII border override */
Screen.legacy-console .card,
Screen.legacy-console DataTable,
Screen.legacy-console RichLog,
Screen.legacy-console Input,
Screen.legacy-console Collapsible,
Screen.legacy-console #progress-panel,
Screen.legacy-console #dash-summary,
Screen.legacy-console #backups-summary {
    border: ascii #484f58;
}

Screen.legacy-console #top-header {
    border-bottom: ascii #484f58;
}

Screen.legacy-console #nav-rail {
    border-right: ascii #484f58;
}

Screen.legacy-console #modal-box,
Screen.legacy-console #wizard-box,
Screen.legacy-console #diff-box {
    border: ascii #58a6ff;
}

/* Modals & Wizard */
ConfirmModal, OnboardingModal, DiffModal, UpdateModal {
    align: center middle;
    background: rgba(1, 4, 9, 0.78);
}

#modal-box, #wizard-box, #diff-box {
    width: 78;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: solid #58a6ff;
    padding: 1 2;
}

#wizard-step-label {
    color: #79c0ff;
    text-style: bold;
    margin-bottom: 1;
}

#wizard-body, #diff-scroll {
    height: auto;
    min-height: 8;
    max-height: 18;
    margin-bottom: 1;
}

#wizard-nav {
    height: auto;
}
